{
  "name": "@waypoint/builder",
  "version": "0.1.0",
  "description": "No-code journey builder for Waypoint",
  "keywords": [
    "waypoint",
    "builder",
    "journey",
    "no-code",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@waypoint/core": "workspace:*",
    "@waypoint/react": "workspace:*",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.3",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^28.1.0",
    "react": "^18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
