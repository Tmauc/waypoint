{
  "name": "@waypoint/devtools",
  "version": "0.1.0",
  "description": "Dev-only debug panel for Waypoint Runtime",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@waypoint/core": "workspace:*",
    "@waypoint/next": "workspace:*",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
